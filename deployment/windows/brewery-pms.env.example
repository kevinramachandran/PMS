# This file is copied automatically to config\brewery-pms.env on first start.
# Edit brewery-pms.env on the target VM when MySQL uses different credentials.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_TIMEZONE=UTC

DB_URL=jdbc:mysql://localhost:3306/brewery_pms?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=Password@123

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SQL=WARN
JPA_SHOW_SQL=false
LOG_FILE=C:\Brewery-PMS\logs\brewery-pms.log

UPLOAD_DIR=C:\Brewery-PMS\uploads\footer-buttons
APP_EMAIL_CONFIG_SECRET=change-this-to-a-long-random-value
APP_EMAIL_CONFIG_TEST_RATE_LIMIT_MS=5000
APP_INTERNAL_SIVA_PASSWORD=Siva@2026