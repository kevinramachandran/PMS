# This file is copied automatically to config\brewery-pms.env on first start.
# Edit brewery-pms.env on the target VM when MySQL uses different credentials.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=165
# Change SERVER_PORT here (in brewery-pms.env) and restart; launch URLs follow it.
APP_TIMEZONE=UTC

DB_HOST=localhost
DB_PORT=3306
DB_NAME=brewery_pms
# Optional advanced override: DB_URL takes precedence over DB_HOST/DB_PORT/DB_NAME.
# Remove an old DB_URL entry when switching to DB_NAME.
# The MySQL account needs CREATE permission to create a missing database.
DB_USERNAME=root
DB_PASSWORD=Password@123

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_WEB=INFO
LOG_LEVEL_SQL=WARN
JPA_SHOW_SQL=false
# Relative paths resolve inside this instance's installation directory.
LOG_FILE=logs/brewery-pms.log

UPLOAD_DIR=uploads/footer-buttons
ATTACHMENT_UPLOAD_DIR=uploads/attachments
APP_EMAIL_CONFIG_SECRET=change-this-to-a-long-random-value
APP_EMAIL_CONFIG_TEST_RATE_LIMIT_MS=5000
APP_SYNC_SECRET=change-this-to-a-long-random-value
